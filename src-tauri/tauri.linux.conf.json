{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "desktopTemplate": "./linux/svp.desktop",
        "depends": [
          "ffmpeg",
          "xdg-utils"
        ],
        "recommends": [
          "gstreamer1.0-libav",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad"
        ]
      },
      "rpm": {
        "desktopTemplate": "./linux/svp.desktop",
        "depends": [
          "/usr/bin/ffmpeg",
          "/usr/bin/ffprobe",
          "xdg-utils"
        ],
        "recommends": [
          "gstreamer1-plugin-libav",
          "gstreamer1-plugins-good",
          "gstreamer1-plugins-bad-free"
        ]
      }
    }
  }
}
