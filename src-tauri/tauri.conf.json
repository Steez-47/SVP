{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SVP",
  "version": "0.1.2",
  "identifier": "com.steez.svp",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "node scripts/sync-steez.mjs",
    "beforeBuildCommand": "node scripts/sync-steez.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SVP",
        "width": 1180,
        "height": 720,
        "minWidth": 520,
        "minHeight": 320,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#000000",
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installMode": "currentUser"
      }
    },
    "publisher": "Steez-47",
    "copyright": "Copyright © 2026 Steez-47",
    "category": "Video",
    "shortDescription": "Steez Video Player",
    "longDescription": "Steez Video Player: a lightweight video player with frame stepping, lossless trim, compression and side-by-side compare."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzODgxRTc0NjBFMDI2RjkKUldUNUp1QmdkQjZJNDAwMjY5T2pNTmU4aVpNcGxDMjBLbGc2VkN3NkdIQjZpMU1DQ0FtN3dFZFkK",
      "endpoints": [
        "https://github.com/Steez-47/SVP/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
